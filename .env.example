APP_NAME="Plataforma Fitness"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academia
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=academia_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

LOG_CHANNEL=daily
LOG_LEVEL=debug

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Plataforma Fitness"

# Identidade visual opcional (hexadecimal). Vazio usa o tema padrão.
BRAND_PRIMARY=
BRAND_ACCENT=
BRAND_BACKGROUND=
BRAND_SURFACE=
